{
  "name": "@signet/indexer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node init && tsx watch src/index.ts",
    "start": "node init && tsx src/index.ts",
    "build": "node init && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --config ../../eslint.config.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@signet/db": "workspace:*",
    "@signet/types": "workspace:*",
    "@stellar/stellar-sdk": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
